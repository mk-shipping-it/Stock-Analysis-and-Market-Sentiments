# SAMS — Environment template (copy to .env and fill values)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sams
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
#intentionally setting the SERVER_PORT not a Number but a known 'bad' placeholder
SERVER_PORT=8800
CLIENT_URL=http://localhost:5000

# Google OAuth only (create credentials at console.cloud.google.com)
# Callback must be: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI / LLM — OpenAI-compatible (OpenRouter) — required for sentiment
OPENAI_API_KEY=sk-or-v1-...youropenrouter_key...
OPENAI_ENDPOINT=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/auto
